<?xml version="1.0"?>
<odoo>
    <data>

                              <!-- Dashboard-->
        <record id="view_clinica_dashboard" model="ir.ui.view">
            <field name="name">clinica.dashboard.form</field>
            <field name="model">clinica.dashboard</field>
            <field name="arch" type="xml">
                <form string="Dashboard" create="false" edit="false" delete="false" duplicate="false">
                    <script type="text/javascript" src="/im_livechat/loader/2"></script>
                    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
                    <script type="text/javascript" src="/odoo_sample_module/static/src/js/clinica_dashboard.js"></script>
                    
                    <div class="o_dashboard_container" style="background-color: #f8f9fa; min-height: 100vh; padding: 20px;">
                        
                        <div class="row mb-4">
                            <div class="col-12 text-center">
                                <h1 style="color: #714B67; font-weight: bold; margin-bottom: 5px;">Sistema Clínica</h1>
                                <p class="text-muted" style="font-size: 1.1rem;">Visão Geral de Vendas e Atendimentos</p>
                                <div style="height: 3px; background-color: #714B67; width: 60px; margin: 10px auto; border-radius: 2px; opacity: 0.5;"></div>
                            </div>
                        </div>

                        <div class="row mb-4">
                            <div class="col-md-3">
                                <div class="card shadow-sm border-0 text-center p-3" style="border-radius: 10px; border-top: 4px solid #714B67 !important;">
                                    <h6 class="text-uppercase text-muted small font-weight-bold">Faturamento Total</h6>
                                    <h3 id="kpi_faturamento" style="color: #714B67;" class="font-weight-bold">R$ 0,00</h3>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="card shadow-sm border-0 text-center p-3" style="border-radius: 10px; border-top: 4px solid #28a745 !important;">
                                    <h6 class="text-uppercase text-muted small font-weight-bold">Vendas de Produtos</h6>
                                    <h3 id="kpi_produtos" class="text-success font-weight-bold">0</h3>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="card shadow-sm border-0 text-center p-3" style="border-radius: 10px; border-top: 4px solid #17a2b8 !important;">
                                    <h6 class="text-uppercase text-muted small font-weight-bold">Procedimentos</h6>
                                    <h3 id="kpi_procedimentos" class="text-info font-weight-bold">0</h3>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="card shadow-sm border-0 text-center p-3" style="border-radius: 10px; border-top: 4px solid #ffc107 !important;">
                                    <h6 class="text-uppercase text-muted small font-weight-bold">Agendamentos Hoje</h6>
                                    <h3 id="kpi_agendamentos" class="text-warning font-weight-bold">0</h3>
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-8 mb-4">
                                <div class="card shadow-sm border-0 p-4" style="border-radius: 15px; height: 400px;">
                                    <h5 class="font-weight-bold mb-3" style="color: #444;">Evolução de Vendas</h5>
                                    <div id="chart_vendas_line" style="background: #ffffff; height: 100%; border-radius: 8px; display: flex; align-items: center; justify-content: center; border: 1px dashed #ccc;">
                                        <canvas id="canvas_vendas_line"></canvas>
                                    </div>
                                </div>
                            </div>

                            <div class="col-md-4 mb-4">
                                <div class="card shadow-sm border-0 p-4" style="border-radius: 15px; height: 400px;">
                                    <h5 class="font-weight-bold mb-3" style="color: #444;">Mix de Receita</h5>
                                    <div id="chart_vendas_donut" style="background: #ffffff; height: 100%; border-radius: 8px; display: flex; align-items: center; justify-content: center; border: 1px dashed #ccc;">
                                        <canvas id="canvas_vendas_donut"></canvas>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div id="chatbot" class="o_ptr_chat_container" style="position: fixed; bottom: 20px; right: 20px; width: 320px; z-index: 1000;">
                            <div class="card shadow-lg border-0" style="border-radius: 15px; overflow: hidden;">
                                <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center" style="background-color: #714B67 !important;">
                                    <span class="font-weight-bold"><i class="fa fa-comments mr-2"></i>Assistente Clínica</span>
                                    <i class="fa fa-minus" id="btn-minimizar" style="cursor: pointer; padding: 5px;" title="Minimizar"></i>
                                </div>
                                <div id="chat-messages" class="card-body" style="height: 200px; overflow-y: auto; background: #fff; display: flex; flex-direction: column; font-size: 0.9rem;">
                                    </div>
                                <div id="chat-footer" class="card-footer bg-white border-0">
                                    <div class="input-group">
                                        <input type="text" id="chat-input" class="form-control border-light" placeholder="Como posso ajudar?" style="background: #f4f4f4; border-radius: 20px 0 0 20px;"/>
                                        <div class="input-group-append">
                                            <button class="btn btn-primary" id="btn-enviar" style="background-color: #714B67; border: none; border-radius: 0 20px 20px 0;">
                                                <i class="fa fa-paper-plane"></i>
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div> 

                    </div> 
                </form>
            </field>
        </record>

        <record id="action_clinica_dashboard" model="ir.actions.act_window">
            <field name="name">Dashboard Clínica</field>
            <field name="res_model">clinica.dashboard</field>
            <field name="view_mode">form,graph,pivot</field> <field name="target">current</field>
            <field name="view_id" ref="view_clinica_dashboard"/>
        </record>

        <menuitem id="menu_clinica_root" 
          name="Clínica" 
          action="action_clinica_dashboard" 
          sequence="1"
          web_icon="fa fa-magic,#714B67,#ffffff"/>
        <!-- ============================================================ -->
        <!-- 1. PERFIL DO CLIENTE                                          -->
        <!-- ============================================================ -->

        <record id="view_perfil_cliente_form" model="ir.ui.view">
            <field name="name">clinica.perfil.cliente.form</field>
            <field name="model">clinica.perfil.cliente</field>
            <field name="arch" type="xml">
                <form string="Perfil do Cliente">
                    <sheet>
                        <group>
                            <field name="name"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="view_perfil_cliente_list" model="ir.ui.view">
           <field name="name">clinica.perfil.cliente.list</field>
           <field name="model">clinica.perfil.cliente</field>
           <field name="arch" type="xml">
              <list string="Perfis de Cliente">
                 <field name="name"/>
              </list>
            </field>
        </record>         

        <record id="action_perfil_cliente" model="ir.actions.act_window">
            <field name="name">Perfis de Cliente</field>
            <field name="res_model">clinica.perfil.cliente</field>
            <field name="view_mode">list,form</field> <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Nenhum perfil cadastrado. Clique em 'Novo' para criar um!
                </p>
            </field>
        </record>

      
        <menuitem
            id="menu_clinica_config"
            name="Configurações"
            parent="menu_clinica_root"
            sequence="90"/>

        <menuitem
            id="menu_perfil_cliente"
            name="Perfis de Cliente"
            parent="menu_clinica_config"
            action="action_perfil_cliente"
            sequence="10"/>

        <!-- ============================================================ -->
        <!-- 2. CLIENTE (res.partner)                                      -->
        <!-- ============================================================ -->

        <record id="view_partner_form_clinica" model="ir.ui.view">
            <field name="name">res.partner.form.clinica</field>
            <field name="model">res.partner</field>
            <field name="inherit_id" ref="base.view_partner_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='function']" position="after">
                    <field name="primeiro_atendimento"/>
                    <field name="vip"/>
                    <field name="convenio"/>
                    <field name="perfil_cliente_id"/>
                </xpath>
            </field>
        </record>

        <record id="action_clientes_clinica" model="ir.actions.act_window">
            <field name="name">Clientes</field>
            <field name="res_model">res.partner</field>
            <field name="view_mode">list,form,kanban</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Cadastre seu primeiro cliente!
                </p>
            </field>
        </record>

        <menuitem
            id="menu_clientes_clinica"
            name="Clientes"
            parent="menu_clinica_root"
            action="action_clientes_clinica"
            sequence="5"/>


        
        <!-- ============================================================ -->
        <!-- 3. PRODUTO                                                     -->
        <!-- ============================================================ -->

        <record id="view_produto_form" model="ir.ui.view">
            <field name="name">clinica.produto.form</field>
            <field name="model">clinica.produto</field>
            <field name="arch" type="xml">
                <form string="Produto/Serviço">
                    <sheet>
                        <group>
                            <field name="name"/>
                            <field name="tipo_produto"/>
                            <field name="active"/>
                        </group>
                        <notebook>
                            <page string="Preços Base">
                                <field name="preco_base_ids">
                                    <list editable="bottom">
                                        <field name="valor"/>
                                        <field name="data_inicio"/>
                                        <field name="data_fim"/>
                                    </list>
                                </field>
                            </page>
                            <page string="Regras de Preço">
                                <field name="regra_preco_ids">
                                    <list editable="bottom">
                                        <field name="perfil_cliente_id"/>
                                        <field name="quantidade_min"/>
                                        <field name="tipo_regra"/>
                                        <field name="desconto"/>
                                        <field name="data_inicio"/>
                                        <field name="data_fim"/>
                                    </list>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="view_produto_list" model="ir.ui.view">
            <field name="name">clinica.produto.list</field>
            <field name="model">clinica.produto</field>
            <field name="arch" type="xml">
                <list string="Produtos e Serviços">
                    <field name="name"/>
                    <field name="tipo_produto"/>
                    <field name="active" widget="boolean_toggle"/>
                </list>
            </field>
        </record>

        <record id="action_produto" model="ir.actions.act_window">
            <field name="name">Produtos e Serviços</field>
            <field name="res_model">clinica.produto</field>
            <field name="view_mode">list,form</field> <field name="help" type="html">
            <p class="o_view_nocotent_smiling_face">
                Cadastre seu prieiro produto ou Serviço!
            </p>
            </field>
        </record>

        <menuitem
            id="menu_produto"
            name="Produtos e Serviços"
            parent="menu_clinica_root"
            action="action_produto"
            sequence="20"/>



        <!-- ============================================================ -->
        <!-- 4. PREÇO BASE                                                 -->
        <!-- ============================================================ -->

        <record id="view_preco_base_form" model="ir.ui.view">
            <field name="name">clinica.preco.base.form</field>
            <field name="model">clinica.preco.base</field>
            <field name="arch" type="xml">
                <form string="Preço Base">
                    <sheet>
                        <group>
                            <field name="produto_id"/>
                            <field name="valor"/>
                            <field name="data_inicio"/>
                            <field name="data_fim"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="view_preco_base_list" model="ir.ui.view">
            <field name="name">clinica.preco.base.list</field>
            <field name="model">clinica.preco.base</field>
            <field name="arch" type="xml">
                <list string="Preços Base">
                    <field name="produto_id"/>
                    <field name="valor"/>
                    <field name="data_inicio"/>
                    <field name="data_fim"/>
                </list>
            </field>
        </record>

        <record id="action_preco_base" model="ir.actions.act_window">
            <field name="name">Preços Base</field>
            <field name="res_model">clinica.preco.base</field>
            <field name="view_mode">list,form</field>
        </record>

        <menuitem
            id="menu_preco_base"
            name="Preços Base"
            parent="menu_clinica_config"
            action="action_preco_base"
            sequence="20"/>

        

        <!-- ============================================================ -->
        <!-- 5. REGRA DE PREÇO                                            -->
        <!-- ============================================================ -->

        <record id="view_regra_preco_form" model="ir.ui.view">
            <field name="name">clinica.regra.preco.form</field>
            <field name="model">clinica.regra.preco</field>
            <field name="arch" type="xml">
                <form string="Regra de Preço">
                    <sheet>
                        <group>
                            <field name="produto_id"/>
                            <field name="perfil_cliente_id"/>
                            <field name="quantidade_min"/>
                            <field name="tipo_regra"/>
                            <field name="desconto"/>
                            <field name="data_inicio"/>
                            <field name="data_fim"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="view_regra_preco_list" model="ir.ui.view">
            <field name="name">clinica.regra.preco.list</field>
            <field name="model">clinica.regra.preco</field>
            <field name="arch" type="xml">
                <list string="Regras de Preço">
                    <field name="produto_id"/>
                    <field name="perfil_cliente_id"/>
                    <field name="quantidade_min"/>
                    <field name="tipo_regra"/>
                    <field name="desconto"/>
                    <field name="data_inicio"/>
                    <field name="data_fim"/>
                </list>
            </field>
        </record>

        <record id="action_regra_preco" model="ir.actions.act_window">
            <field name="name">Regras de Preço</field>
            <field name="res_model">clinica.regra.preco</field>
            <field name="view_mode">list,form</field>
        </record>

        <menuitem
            id="menu_regra_preco"
            name="Regras de Preço"
            parent="menu_clinica_config"
            action="action_regra_preco"
            sequence="30"/>

        <!-- ============================================================ -->
        <!-- 6. COMBINAÇÃO DE PRODUTO                                      -->
        <!-- ============================================================ -->

        <record id="view_combinacao_produto_form" model="ir.ui.view">
            <field name="name">clinica.combinacao.produto.form</field>
            <field name="model">clinica.combinacao.produto</field>
            <field name="arch" type="xml">
                <form string="Combinação de Produto">
                    <sheet>
                        <group>
                            <field name="produto_principal_id"/>
                            <field name="produto_relacionado_id"/>
                            <field name="tipo_desconto"/>
                            <field name="valor_final"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="view_combinacao_produto_list" model="ir.ui.view">
            <field name="name">clinica.combinacao.produto.list</field>
            <field name="model">clinica.combinacao.produto</field>
            <field name="arch" type="xml">
                <list string="Combinações de Produto">
                    <field name="produto_principal_id"/>
                    <field name="produto_relacionado_id"/>
                    <field name="tipo_desconto"/>
                    <field name="valor_final"/>
                </list>
            </field>
        </record>

        <record id="action_combinacao_produto" model="ir.actions.act_window">
            <field name="name">Combinações de Produto</field>
            <field name="res_model">clinica.combinacao.produto</field>
            <field name="view_mode">list,form</field> <field name="help" type="html">
               <p class="o_view_nocontent_smiling_face">
                  Defina uma nova combinação de produtos e seus descontos!
               </p>   
           </field>
        </record>

        <menuitem
            id="menu_combinacao_produto"
            name="Combinações de Produto"
            parent="menu_clinica_config"
            action="action_combinacao_produto"
            sequence="40"/>

        <!-- ============================================================ -->
        <!-- 7. PEDIDO                                                     -->
        <!-- ============================================================ -->

        <record id="view_pedido_form" model="ir.ui.view">
            <field name="name">clinica.pedido.form</field>
            <field name="model">clinica.pedido</field>
            <field name="arch" type="xml">
                <form string="Pedido">
                    <sheet>
                        <group>
                            <field name="cliente_id"/>
                            <field name="data_hora"/>
                            <field name="valor_total" readonly="1"/>
                        </group>
                        <notebook>
                            <page string="Itens do Pedido">
                                <field name="item_ids">
                                    <list editable="bottom">
                                        <field name="produto_id"/>
                                        <field name="quantidade"/>
                                        <field name="preco_unitario" readonly="1"/>
                                        <field name="desconto_aplicado" readonly="1"/>
                                        <field name="valor_final" readonly="1"/>
                                    </list>
                                </field>
                            </page>
                        </notebook>

                        <header>
                            <button name="action_imprimir_comprovante" 
                                    string="Imprimir Comprovante" 
                                    type="object" 
                                    class="btn-primary"/>
                        </header>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="view_pedido_list" model="ir.ui.view">
            <field name="name">clinica.pedido.list</field>
            <field name="model">clinica.pedido</field>
            <field name="arch" type="xml">
                <list string="Pedidos do Dia" default_order="data_hora desc">
                    <field name="data_hora"/>
                    <field name="cliente_id"/>
                    <field name="valor_total" sum="Total Geral"/>
                </list>
            </field>
        </record>

        <record id="action_pedido" model="ir.actions.act_window">
            <field name="name">Pedidos</field>
            <field name="res_model">clinica.pedido</field>
            <field name="view_mode">list,form</field> <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Nenhum pedido encontrado. Clique em 'Novo' para criar um!
                </p>
            </field>
        </record>


        <menuitem
            id="menu_pedido"
            name="Pedidos"
            parent="menu_clinica_root"
            action="action_pedido"
            sequence="10"/>

        <!-- ============================================================ -->
        <!-- 8. ITEM DO PEDIDO                                            -->
        <!-- ============================================================ -->

        <record id="view_item_pedido_form" model="ir.ui.view">
            <field name="name">clinica.item.pedido.form</field>
            <field name="model">clinica.item.pedido</field>
            <field name="arch" type="xml">
                <form string="Item do Pedido">
                    <sheet>
                        <group>
                            <field name="pedido_id"/>
                            <field name="produto_id"/>
                            <field name="quantidade"/>
                            <field name="preco_unitario" readonly="1"/>
                            <field name="desconto_aplicado" readonly="1"/>
                            <field name="valor_final" readonly="1"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>




        <!-- ============================================================ -->
        <!-- 9. Relatorio de preços                                           -->
        <!-- ============================================================ -->


    <record id="action_report_tabela_precos" model="ir.actions.report">
        <field name="name">Tabela de Preços por Período</field>
        <field name="model">clinica.relatorio.preco.wizard</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">odoo_sample_module.report_tabela_precos_template</field>
        <field name="report_file">odoo_sample_module.report_tabela_precos_template</field>
        <field name="print_report_name">'Tabela_Precos'</field>
        <field name="binding_model_id" eval="False"/>
    </record>

    <template id="report_tabela_precos_template">
        <t t-call="web.html_container">
            <t t-call="web.external_layout">
                <div class="page">
                    <div class="text-center">
                        <h2>Tabela de Preços e Produtos</h2>
                        <p>Período: <span t-esc="form.get('data_inicio')"/> até <span t-esc="form.get('data_fim')"/></p>
                    </div>

                    <table class="table table-sm table-striped mt-4">
                        <thead>
                            <tr>
                                <th>Produto/Serviço</th>
                                <th class="text-right">Preço Base</th>
                                <th>Início Vigência</th>
                                <th>Fim Vigência</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="request.env['clinica.preco.base'].browse(precos)" t-as="line">
                                <tr>
                                    <td><span t-field="line.produto_id.name"/></td>
                                    <td class="text-right">
                                        R$ <span t-field="line.valor"/>
                                    </td>
                                    <td>
                                        <span t-field="line.data_inicio" t-options='{"format": "dd/MM/yyyy"}'/>
                                    </td>

                                    <td>
                                        <span t-field="line.data_fim" t-options='{"format": "dd/MM/yyyy"}'/>
                                    </td>
                                </tr>
                            </t>
                        </tbody>
                    </table>
                </div>
            </t>
        </t>
    </template>

    <record id="view_relatorio_preco_wizard_form" model="ir.ui.view">
        <field name="name">clinica.relatorio.preco.wizard.form</field>
        <field name="model">clinica.relatorio.preco.wizard</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="data_inicio"/>
                    <field name="data_fim"/>
                </group>
                <footer>
                    <button name="imprimir_relatorio" string="Gerar PDF" type="object" class="btn-primary"/>
                    <button string="Cancelar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_relatorio_preco_wizard" model="ir.actions.act_window">
        <field name="name">Gerar Tabela de Preços</field>
        <field name="res_model">clinica.relatorio.preco.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_relatorio_preco_wizard_form"/>
        <field name="target">new</field>
    </record>

    <menuitem id="menu_relatorio_precos"
            name="Relatório de Preços"
            parent="menu_clinica_config" 
            action="action_relatorio_preco_wizard"
            sequence="100"/>

        <!-- ============================================================ -->
        <!-- 10. RELATÓRIO DE VENDAS POR PERÍODO                            -->
        <!-- ============================================================ -->

        <!-- Ação do Relatório (PDF) -->
        <record id="action_report_vendas_periodo" model="ir.actions.report">
            <field name="name">Relatório de Vendas por Período</field>
            <field name="model">clinica.relatorio.vendas.wizard</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">odoo_sample_module.report_vendas_periodo_template</field>
            <field name="report_file">odoo_sample_module.report_vendas_periodo_template</field>
            <field name="print_report_name">'Relatorio_Vendas'</field>
            <field name="binding_model_id" eval="False"/>
        </record>

        <!-- Template QWeb para o Relatório de Vendas -->
        <template id="report_vendas_periodo_template">
            <t t-call="web.html_container">
                <t t-call="web.external_layout">
                    <div class="page">
                        <div class="text-center">
                            <h2>Relatório de Vendas</h2>
                            <p>Período de <span t-esc="form.get('data_inicio')"/> até <span t-esc="form.get('data_fim')"/></p>
                        </div>

                        <div class="row mt-4 mb-4">
                            <div class="col-6">
                                <strong>Total de Pedidos:</strong>
                                <span t-esc="form.get('quantidade_pedidos')"/>
                            </div>
                            <div class="col-6 text-right">
                                <strong>Valor Total das Vendas:</strong>
                                R$ <span t-esc="form.get('total_vendas')" t-options='{"widget": "float", "precision": 2}'/>
                            </div>
                        </div>

                        <table class="table table-sm table-striped mt-4">
                            <thead>
                                <tr>
                                    <th>Data do Pedido</th>
                                    <th>Cliente</th>
                                    <th class="text-right">Valor Total (R$)</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="request.env['clinica.pedido'].browse(pedidos)" t-as="pedido">
                                    <tr>
                                        <td>
                                            <span t-field="pedido.data_hora" t-options='{"format": "dd/MM/yyyy HH:mm"}'/>
                                        </td>
                                        <td>
                                            <span t-field="pedido.cliente_id.name"/>
                                        </td>
                                        <td class="text-right">
                                            <span t-field="pedido.valor_total"/>
                                        </td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>
                    </div>
                </t>
            </t>
        </template>

        <record id="view_relatorio_vendas_wizard_form" model="ir.ui.view">
            <field name="name">clinica.relatorio.vendas.wizard.form</field>
            <field name="model">clinica.relatorio.vendas.wizard</field>
            <field name="arch" type="xml">
                <form>
                    <group>
                        <field name="data_inicio"/>
                        <field name="data_fim"/>
                    </group>
                    <footer>
                        <button name="imprimir_relatorio" string="Gerar PDF" type="object" class="btn-primary"/>
                        <button string="Cancelar" class="btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

        <!-- Ação da Janela (Wizard) que o menu irá chamar -->
        <record id="action_relatorio_vendas_wizard" model="ir.actions.act_window">
            <field name="name">Gerar Relatório de Vendas</field>
            <field name="res_model">clinica.relatorio.vendas.wizard</field>
            <field name="view_mode">form</field>
        <field name="view_id" ref="view_relatorio_vendas_wizard_form"/>
            <field name="target">new</field>
        </record>

        <!-- Item de Menu -->
        <menuitem id="menu_relatorio_vendas"
                name="Relatório de Vendas"
                parent="menu_clinica_config" 
                action="action_relatorio_vendas_wizard"
                sequence="110"/>

              <!-- Comprovante de Venda!-->

    <record id="action_report_comprovante_pedido" model="ir.actions.report">
        <field name="name">Comprovante de Venda</field>
        <field name="model">clinica.pedido</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">odoo_sample_module.report_comprovante_pedido</field>
        <field name="report_file">odoo_sample_module.report_comprovante_pedido</field>
        <field name="print_report_name">'Comprovante - %s' % (object.cliente_id.name)</field>
    </record>

   <template id="report_comprovante_pedido">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="web.external_layout">
                    <div class="page">
                        <h2>Comprovante de Venda</h2>
                        <p>Cliente: <span t-field="doc.cliente_id.name"/></p>
                        <p>Data: <span t-field="doc.data_hora" t-options='{"format": "dd/MM/yyyy HH:mm"}'/></p>
                        
                        <table class="table table-sm">
                            <thead>
                                <tr>
                                    <th>Produto</th>
                                    <th class="text-center">Qtd</th>
                                    <th class="text-right">Valor Final</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="doc.item_ids" t-as="item">
                                    <tr>
                                        <td><span t-field="item.produto_id.name"/></td>
                                        <td class="text-center"><span t-field="item.quantidade"/></td>
                                        <td class="text-right"><span t-field="item.valor_final"/></td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>
                        <p class="text-right">
                            <strong>Total: <span t-field="doc.valor_total"/></strong>
                        </p>
                    </div>
                </t>
            </t>
        </t>
    </template>

    </data>
</odoo>